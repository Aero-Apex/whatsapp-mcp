# Copy to http.env (in the project root) and fill in. Never commit the real file.

# Long random secret that clients must send as "Authorization: Bearer <MCP_TOKEN>".
# Generate one with: openssl rand -hex 32
MCP_TOKEN=change-me-to-a-long-random-value

# Public hostname used for DNS-rebinding protection (the name clients connect to). Use localhost for local-only testing.
PUBLIC_HOST=localhost

# Address and port for the HTTP MCP server. Keep HOST on 127.0.0.1 and publish it through a tunnel or proxy.
HOST=127.0.0.1
PORT=8795
